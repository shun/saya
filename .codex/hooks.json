{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "deno run --allow-read --allow-write --allow-run \"$(git rev-parse --show-toplevel)/.codex/hooks/stop_require_verification.ts\"",
            "timeout": 30,
            "statusMessage": "Checking required verification"
          }
        ]
      }
    ]
  }
}
