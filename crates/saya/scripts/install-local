#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/distribution-common.sh
source "$SCRIPT_DIR/distribution-common.sh"

prefix="${PREFIX:-$HOME/.local}"

saya_build_release_binary

install -d "$prefix/bin" "$prefix/share"
binary_path="$(saya_binary_path)"
bin_path="$prefix/bin/sy"
if [[ -e "$bin_path" && "$binary_path" -ef "$bin_path" ]]; then
  printf 'installed sy: %s (already points to %s)\n' "$bin_path" "$binary_path"
else
  install -m 0755 "$binary_path" "$bin_path"
  printf 'installed sy: %s\n' "$bin_path"
fi
saya_copy_home "$prefix/share/saya"

printf 'installed SAYA_HOME: %s\n' "$prefix/share/saya"
